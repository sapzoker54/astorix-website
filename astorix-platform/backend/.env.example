# ============================================================
# ASTORIX Platform — Environment Variables
# Copy this to .env and fill in values
# NEVER commit .env to GitHub
# ============================================================

NODE_ENV=production
PORT=3001
APP_VERSION=1.0.0
APP_URL=https://app.astorix.ai
LOG_LEVEL=info

# ============================================================
# DATABASE — Azure PostgreSQL Flexible Server
# ============================================================
DB_HOST=astorix-db.postgres.database.azure.com
DB_PORT=5432
DB_NAME=astorix_platform
DB_USER=astorix_admin
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_SSL=true
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000

# ============================================================
# REDIS — Azure Cache for Redis
# ============================================================
REDIS_URL=rediss://astorix-cache.redis.cache.windows.net:6380
REDIS_PASSWORD=REPLACE_WITH_REDIS_KEY
REDIS_TLS=true

# ============================================================
# AUTHENTICATION
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=1h

# ============================================================
# CORS — allowed frontend origins
# ============================================================
ALLOWED_ORIGINS=https://app.astorix.ai,https://astorix.ai

# ============================================================
# STRIPE — Subscription Billing
# (Set up at dashboard.stripe.com — add after MVP)
# ============================================================
STRIPE_SECRET_KEY=sk_live_REPLACE_AFTER_STRIPE_SETUP
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_AFTER_STRIPE_SETUP
STRIPE_PRICE_BASIC_MONTHLY=price_REPLACE
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE
STRIPE_PRICE_CIVICOPS_MONTHLY=price_REPLACE

# ============================================================
# EMAIL — Azure Communication Services or SendGrid
# ============================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SENDGRID_KEY
FROM_EMAIL=noreply@astorix.ai
FROM_NAME=ASTORIX Platform

# ============================================================
# AZURE (for Application Insights telemetry)
# ============================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=REPLACE_IF_USING_APP_INSIGHTS
